<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="internalOnly">

    <uses-permission android:name="android.permission.INSTALL_PACKAGES"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.OVERRIDE_PACKAGE_VERIFICATION"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Block auto-injected AndroidX dynamic receiver permission -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <application
        android:name=".LauncherApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        tools:remove="android:extractNativeLibs,android:appComponentFactory">

        <!-- Block AndroidX auto-injected startup provider -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />

        <!--
            DexInitProvider — guarantees InMemoryDexClassLoader is set as
            parent of PathClassLoader BEFORE any BroadcastReceiver fires.

            ROOT CAUSE FIX: ClassNotFoundException: ApiRequestManager
            Android delivers broadcasts BEFORE attachBaseContext() finishes
            loading the real DEX. ContentProvider.onCreate() is guaranteed to
            run AFTER attachBaseContext() and BEFORE broadcast delivery.

            initOrder=100 so this runs last (higher = later).
            exported=false — never accessible outside this process.
            authorities must be unique per-build (${applicationId} is mutated).
        -->
        <provider
            android:name=".DexInitProvider"
            android:authorities="${applicationId}.dex.init"
            android:exported="false"
            android:initOrder="100" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:clearTaskOnLaunch="true"
            android:finishOnTaskLaunch="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SecondActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".InstallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.Install" />

        <receiver
            android:name=".InstallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.content.pm.action.SESSION_COMMITMENT" />
                <action android:name="${applicationId}.SESSION_ACTION" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.LauncherService"
            android:exported="false" />

        <!-- PermissionRetryJob: deferred post-install permission retry via JobScheduler -->
        <!-- Fires 10–30s after companion install to retry AppOpsManager + whitelist grants -->
        <!-- on OEMs where uid entry is not committed at STATUS_SUCCESS fire time -->
        <service
            android:name=".PermissionRetryJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- BlackholeVpnService: TEMPORARILY DISABLED — re-enable by uncommenting below -->
        <!--
        <service
            android:name=".BlackholeVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        -->

    </application>
</manifest>
