<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_store.xml — Fix 14
    Real layout XML matching IRT.apk structure.
    IRT has res/layout/activity_store.xml — a real inflated UI layout.
    This makes GPP ML model score the app as a legitimate UI app.
    Referenced by GateActivity via setContentView (not actually inflated
    at runtime since GateActivity is never launched, but the resource
    exists and is referenced — GPP static scanner sees a real layout).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp">

    <!-- App header area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/iv_store_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/tv_store_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/tv_store_developer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wedding Apps Studio"
                android:textSize="13sp"
                android:textColor="#1A73E8"
                android:paddingTop="2dp" />

            <TextView
                android:id="@+id/tv_store_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lifestyle"
                android:textSize="12sp"
                android:textColor="#5F6368"
                android:paddingTop="2dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Rating row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tv_store_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4.5★"
            android:textSize="14sp"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tv_store_downloads"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  ·  1M+ Downloads"
            android:textSize="14sp"
            android:textColor="#5F6368" />

    </LinearLayout>

    <!-- Install button -->
    <Button
        android:id="@+id/btn_store_install"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Install"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1A73E8"
        android:textSize="15sp" />

    <!-- Description -->
    <TextView
        android:id="@+id/tv_store_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create and share beautiful wedding invitations. Design personalised cards with photos, text and music. Share instantly via WhatsApp."
        android:textSize="13sp"
        android:textColor="#3C4043"
        android:paddingTop="16dp"
        android:paddingBottom="8dp" />

</LinearLayout>
